[project]
name = "backend"
version = "0.1.0"
description = "AI Border Screening API"
readme = "README.md"
authors = [
    { name = "sinjan-biswas", email = "sinjanbiswas1024@gmail.com" }
]
requires-python = ">=3.12,<3.13"
dependencies = [
    "fastapi>=0.141.1",
    "grad-cam>=1.5.7",
    "insightface>=2.0",
    "numpy>=2.5.3",
    "onnxruntime>=1.29.0",
    "onnx>=1.16,<1.17",
    "opencv-python-headless>=5.0.0.93",
    # --- Paddle pins: GPU wheel from the official paddle index ---
    "paddlepaddle-gpu==3.0.0",
    "paddleocr>=2.7,<3",
    "paddlex>=3.0,<3.2",
    # ----------------------------------------------------------------
    "pillow>=12.3.0",
    "protobuf>=4.25.3,<5",
    "pydantic>=2.13.5",
    "python-multipart>=0.0.32",
    "sentencepiece==0.2.1",
    "transformers==4.46.3",
    "uvicorn>=0.52.4",
    "redis[hiredis]>=8.1.0",
    "pydantic-settings>=2.15.0",
    "python-jose[cryptography]>=3.5.0",
    "mediapipe==0.10.14",
    "tiktoken>=0.14.0",
    "torch",
    "torchvision",
]

[project.scripts]
backend = "backend:main"

[project.optional-dependencies]
train = [
    "torch>=2.2",
    "torchvision>=0.17",
    "scikit-learn>=1.3",
    "tqdm>=4.66",
    "Pillow>=10.0",
]

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = []

# ----- uv configuration (single block, no duplicates) -----
[tool.uv]
package = false

# Only resolve for Linux x86_64. Skips the Windows-only protobuf conflict.
environments = [
    "sys_platform == 'linux' and platform_machine == 'x86_64'",
]

# ----- Custom package indexes -----
[[tool.uv.index]]
name = "pytorch-cu130"
url = "https://download.pytorch.org/whl/cu130"
explicit = true

[[tool.uv.index]]
name = "paddle-cu126"
url = "https://www.paddlepaddle.org.cn/packages/stable/cu126/"
explicit = true

# ----- Source → index mappings -----
[tool.uv.sources]
torch = { index = "pytorch-cu130" }
torchvision = { index = "pytorch-cu130" }
paddlepaddle-gpu = { index = "paddle-cu126" }