FROM python:3.10-slim
RUN apt-get update && apt-get install -y tesseract-ocr libtesseract-dev libgl1-mesa-glx libsm6 libxext6 libxrender-dev && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY . .
CMD ["celery", "-A", "tasks", "worker", "--loglevel=info"]
